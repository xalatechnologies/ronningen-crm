# Supabase (required) — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Use either legacy anon JWT or new publishable key (sb_publishable_…); not both required
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional: local dev convenience only (never set real secrets in production)
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox Search JS (address autofill on organization settings)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Stripe SaaS billing (500 NOK/month, 30-day trial)
# Use test/sandbox keys when BILLING_MODE=sandbox; live keys only in production when ready
NEXT_PUBLIC_BILLING_ENABLED=false
BILLING_ENABLED=false
BILLING_MODE=sandbox
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRODUCT_STANDARD=
# Legacy alias — STRIPE_PRICE_STANDARD preferred
STRIPE_PRICE_ID=

# Daily billing enforcement cron (Vercel Cron or external scheduler)
CRON_SECRET=

# Platform notification emails (Resend — admin Varsler + transactional)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Rønningen Manager <varsler@yourdomain.com>"

# Stripe setup: npm run stripe:setup (creates product + price, prints STRIPE_PRICE_STANDARD)
# Local webhooks: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Also supported: POST /api/stripe/webhook
# Register production webhook for checkout.session.completed, customer.subscription.*, invoice.payment_failed, invoice.paid
