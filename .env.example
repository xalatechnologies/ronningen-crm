# Supabase (required) — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Use either legacy anon JWT or new publishable key (sb_publishable_…); not both required
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: local dev convenience only (never set real secrets in production)
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
