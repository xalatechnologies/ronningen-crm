{
  "name": "ronningen-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u SUPABASE_SERVICE_ROLE_KEY next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:types": "echo 'Regenerate src/types/database.types.ts via Cursor Supabase MCP (generate_typescript_types) or: npx supabase login && npx supabase gen types typescript --linked'",
    "db:push": "echo \"Placeholder: npx supabase db push (requires Supabase CLI & link)\"",
    "db:seed": "echo \"Placeholder: apply supabase/seed.sql via SQL editor or supabase db reset --seed\"",
    "admin:seed": "env -u SUPABASE_SERVICE_ROLE_KEY node --env-file=.env.local scripts/seed-platform-admin.mjs",
    "import:legacy-bookings": "node --env-file=.env.local scripts/import-legacy-bookings.mjs",
    "verify:legacy-migration": "node --env-file=.env.local scripts/verify-legacy-migration.mjs",
    "stripe:setup": "node --env-file=.env.local scripts/stripe-setup.mjs",
    "billing:verify-env": "node --env-file=.env.local scripts/verify-billing-env.mjs",
    "stitch:export": "node --env-file=.env.local scripts/stitch-export.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@mapbox/search-js-react": "^1.5.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@google/stitch-sdk": "^0.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
